{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Taskmigo Migration",
      "request": "launch",
      "mainClass": "io.taskmigo.TaskmigoMigrationApplication",
      "projectName": "migration",
      "cwd": "${workspaceFolder}/server",
      "env": {
        "TASKMIGO_CLIENT_URL": "http://localhost:3000"
      }
    },
    {
      "type": "java",
      "name": "Taskmigo Web",
      "request": "launch",
      "mainClass": "io.taskmigo.TaskmigoApplication",
      "projectName": "web",
      "cwd": "${workspaceFolder}/server",
      "env": {
        "TASKMIGO_DATABASE_URL": "jdbc:postgresql://localhost:5432/taskmigo",
        "TASKMIGO_DATABASE_USERNAME": "taskmigo",
        "TASKMIGO_DATABASE_PASSWORD": "taskmigo",
        "TASKMIGO_OAUTH_SIGNING_KEY_AUTO_CREATE": "true"
      }
    },
    {
      "type": "java",
      "name": "Taskmigo Worker",
      "request": "launch",
      "mainClass": "io.taskmigo.TaskmigoWorkerApplication",
      "projectName": "worker",
      "cwd": "${workspaceFolder}/server",
      "env": {
        "TASKMIGO_DATABASE_URL": "jdbc:postgresql://localhost:5432/taskmigo",
        "TASKMIGO_DATABASE_USERNAME": "taskmigo",
        "TASKMIGO_DATABASE_PASSWORD": "taskmigo"
      }
    }
  ]
}
