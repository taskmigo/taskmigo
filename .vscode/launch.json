{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Taskmigo Migration",
      "request": "launch",
      "mainClass": "io.taskmigo.TaskmigoMigrationApplication",
      "projectName": "migration",
      "cwd": "${workspaceFolder}/server",
      "env": {
        "TASKMIGO_DATABASE_URL": "jdbc:postgresql://localhost:5432/taskmigo",
        "TASKMIGO_DATABASE_USERNAME": "taskmigo",
        "TASKMIGO_DATABASE_PASSWORD": "taskmigo",
        "TASKMIGO_MIGRATION_USER_PASSWORD": "local-password",
        "TASKMIGO_MIGRATION_REGISTERED_CLIENTS_CLI_REGISTRATION_CLIENT_ID": "internal__local-client",
        "TASKMIGO_MIGRATION_REGISTERED_CLIENTS_CLI_REGISTRATION_CLIENT_SECRET": "local-secret",
        "TASKMIGO_MIGRATION_REGISTERED_CLIENTS_CLI_REGISTRATION_CLIENT_AUTHENTICATION_METHODS": "client_secret_basic",
        "TASKMIGO_MIGRATION_REGISTERED_CLIENTS_CLI_REGISTRATION_AUTHORIZATION_GRANT_TYPES": "client_credentials",
        "TASKMIGO_MIGRATION_REGISTERED_CLIENTS_CLI_REGISTRATION_SCOPES": "taskmigo.api",
        "TASKMIGO_MIGRATION_BROWSER_CLIENT_ABSENT": "false",
        "TASKMIGO_MIGRATION_REGISTERED_CLIENTS_BROWSER_REGISTRATION_CLIENT_SECRET": "local-browser-secret",
        "TASKMIGO_MIGRATION_BROWSER_CLIENT_URL": "http://localhost:3000"
      }
    },
    {
      "type": "java",
      "name": "Taskmigo Web",
      "request": "launch",
      "mainClass": "io.taskmigo.TaskmigoApplication",
      "projectName": "web",
      "cwd": "${workspaceFolder}/server",
      "env": {
        "TASKMIGO_DATABASE_URL": "jdbc:postgresql://localhost:5432/taskmigo",
        "TASKMIGO_DATABASE_USERNAME": "taskmigo",
        "TASKMIGO_DATABASE_PASSWORD": "taskmigo",
        "TASKMIGO_OAUTH_SIGNING_KEY_AUTO_CREATE": "true"
      }
    },
    {
      "type": "java",
      "name": "Taskmigo Worker",
      "request": "launch",
      "mainClass": "io.taskmigo.TaskmigoWorkerApplication",
      "projectName": "worker",
      "cwd": "${workspaceFolder}/server",
      "env": {
        "TASKMIGO_DATABASE_URL": "jdbc:postgresql://localhost:5432/taskmigo",
        "TASKMIGO_DATABASE_USERNAME": "taskmigo",
        "TASKMIGO_DATABASE_PASSWORD": "taskmigo"
      }
    }
  ]
}
