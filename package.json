{
  "name": "taskmigo",
  "private": true,
  "scripts": {
    "format:check": "prettier . --check --ignore-unknown",
    "format:fix": "prettier . --write --ignore-unknown --log-level silent"
  },
  "devDependencies": {
    "prettier": "3.9.8",
    "prettier-plugin-java": "2.10.4"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-java"
    ],
    "printWidth": 120,
    "overrides": [
      {
        "files": "**/*.java",
        "options": {
          "tabWidth": 4
        }
      }
    ]
  }
}
