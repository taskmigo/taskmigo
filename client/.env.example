# Application URL
TASKMIGO_CLIENT_URL=http://localhost:3000

# OAuth/OIDC client
TASKMIGO_AUTH_ISSUER=http://localhost:8080
TASKMIGO_AUTH_CLIENT_ID=taskmigo-client
TASKMIGO_AUTH_CLIENT_SECRET=replace-with-the-browser-client-secret
TASKMIGO_AUTH_ALLOW_INSECURE_REQUESTS=true
TASKMIGO_AUTH_SCOPE="openid profile taskmigo.api"
TASKMIGO_AUTH_OIDC_STATE_VERSION=v1

# Navigation
TASKMIGO_AUTH_CALLBACK_PATH=/api/auth/callback
TASKMIGO_AUTH_POST_LOGOUT_REDIRECT_PATH=/
TASKMIGO_AUTH_DEFAULT_RETURN_TO=/account
TASKMIGO_AUTH_RETURN_TO_PARAMETER=returnTo

# Session lifecycle
TASKMIGO_AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
TASKMIGO_AUTH_REFRESH_SKEW_MILLISECONDS=30000

# Cookie serialization and policy
TASKMIGO_AUTH_COOKIE_VERSION=v1
TASKMIGO_AUTH_COOKIE_HTTP_ONLY=true
TASKMIGO_AUTH_COOKIE_SAME_SITE=lax
TASKMIGO_AUTH_COOKIE_SECURE=false
TASKMIGO_AUTH_COOKIE_PATH=/
TASKMIGO_AUTH_SESSION_COOKIE_NAME=taskmigo_session
TASKMIGO_AUTH_SESSION_COOKIE_AAD=taskmigo-client:session:v1
TASKMIGO_AUTH_SESSION_MAX_AGE_SECONDS=28800
TASKMIGO_AUTH_TRANSACTION_COOKIE_NAME=taskmigo_auth_transaction
TASKMIGO_AUTH_TRANSACTION_COOKIE_AAD=taskmigo-client:transaction:v1
TASKMIGO_AUTH_TRANSACTION_MAX_AGE_SECONDS=600

# No browser-visible configuration is currently required.
