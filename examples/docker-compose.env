# Local development only. Do not reuse these credentials outside this sample.
COMPOSE_PROJECT_NAME=taskmigo-local
DATABASE_PASSWORD=taskmigo-database-password
BOOTSTRAP_USERNAME=developer
BOOTSTRAP_PASSWORD=developer-password
SPRING_SECURITY_OAUTH2_AUTHORIZATIONSERVER_ISSUER=http://localhost:9000
SPRING_APPLICATION_JSON={"spring":{"security":{"oauth2":{"authorizationserver":{"client":{"browser":{"registration":{"client-id":"taskmigo-browser","client-name":"Taskmigo browser","client-secret":"{noop}browser-secret","client-authentication-methods":["client_secret_basic"],"authorization-grant-types":["authorization_code","refresh_token"],"redirect-uris":["http://127.0.0.1:8080/callback","https://oauth.pstmn.io/v1/callback"],"post-logout-redirect-uris":["http://127.0.0.1:8080/"],"scopes":["openid","profile","email","api.read","api.admin","offline_access"]},"require-proof-key":true,"require-authorization-consent":false},"worker":{"registration":{"client-id":"taskmigo-worker","client-name":"Taskmigo worker","client-secret":"{noop}worker-secret","client-authentication-methods":["client_secret_basic"],"authorization-grant-types":["client_credentials"],"scopes":["api.read","api.admin"]},"require-proof-key":false}}}}}}}
