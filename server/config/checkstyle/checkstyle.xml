<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="severity" value="error"/>

    <!-- Reject tab characters in source files. -->
    <module name="FileTabCharacter"/>

    <module name="TreeWalker">
        <!-- Require one statement per line. -->
        <module name="OneStatementPerLine"/>

        <!-- Require class members to follow a consistent declaration order. -->
        <module name="DeclarationOrder"/>

        <!-- Require overloaded methods to be declared together. -->
        <module name="OverloadMethodsDeclarationOrder"/>

        <!-- Constructor injection is mandatory; never use an @Autowired injection annotation. -->
        <module name="MatchXpath">
            <property
                name="query"
                value="//ANNOTATION[
                      IDENT[@text='Autowired']
                      or DOT/IDENT[@text='Autowired']
                    ]"
            />
            <message
                key="matchxpath.match"
                value="@Autowired is forbidden. Use constructor injection with an unannotated constructor."
            />
        </module>

        <!-- Require Bean methods to remain package-private. -->
        <module name="MatchXpath">
            <property
                name="query"
                value="//METHOD_DEF[
                      MODIFIERS/ANNOTATION/IDENT[@text='Bean']
                      and MODIFIERS/*[not(self::ANNOTATION)]
                    ]"
            />
            <message
                key="matchxpath.match"
                value="@Bean methods must not declare any modifier keyword (package-private only)."
            />
        </module>
    </module>
</module>
