<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="severity" value="error"/>

    <module name="SuppressWarningsFilter"/>

    <!-- Reject tab characters in source files. -->
    <module name="FileTabCharacter"/>

    <module name="TreeWalker">
        <module name="SuppressWarningsHolder"/>

        <!-- Require one statement per line. -->
        <module name="OneStatementPerLine"/>

        <!-- Require class members to follow a consistent declaration order. -->
        <module name="DeclarationOrder"/>

        <!-- Require overloaded methods to be declared together. -->
        <module name="OverloadMethodsDeclarationOrder"/>

        <!-- Require imported type names instead of package-qualified type references in source code. -->
        <module name="MatchXpath">
            <property name="id" value="FullyQualifiedName"/>
            <property
                name="query"
                value="//DOT[
                      ./IDENT[last()][matches(@text, '^[A-Z_$]')]
                      and .//IDENT[matches(@text, '^[a-z_$]')]
                      and not(ancestor::PACKAGE_DEF or ancestor::IMPORT or ancestor::STATIC_IMPORT)
                    ]"
            />
            <message
                key="matchxpath.match"
                value="Fully qualified type names are forbidden. Import the type and use its simple name instead."
            />
        </module>

        <!-- package-info.java commonly needs package-qualified annotation names and is the sole FQN exception. -->
        <module name="SuppressionXpathSingleFilter">
            <property name="files" value="(^|.*[/\\])package-info[.]java$"/>
            <property name="id" value="FullyQualifiedName"/>
            <property name="query" value="//*"/>
        </module>

        <!-- Make test reports readable without relying on implementation-oriented method names. -->
        <module name="MatchXpath">
            <property name="id" value="JUnitDisplayName"/>
            <property
                name="query"
                value="//METHOD_DEF[
                      MODIFIERS/ANNOTATION[
                        IDENT[@text='Test']
                        or DOT/IDENT[@text='Test']
                        or IDENT[@text='ParameterizedTest']
                        or DOT/IDENT[@text='ParameterizedTest']
                        or IDENT[@text='RepeatedTest']
                        or DOT/IDENT[@text='RepeatedTest']
                        or IDENT[@text='TestFactory']
                        or DOT/IDENT[@text='TestFactory']
                        or IDENT[@text='TestTemplate']
                        or DOT/IDENT[@text='TestTemplate']
                      ]
                      and not(MODIFIERS/ANNOTATION[
                        IDENT[@text='DisplayName']
                        or DOT/IDENT[@text='DisplayName']
                      ])
                    ]"
            />
            <message
                key="matchxpath.match"
                value="JUnit test methods must declare @org.junit.jupiter.api.DisplayName."
            />
        </module>

        <!-- Constructor injection is mandatory; never use an @Autowired injection annotation. -->
        <module name="MatchXpath">
            <property
                name="query"
                value="//ANNOTATION[
                      IDENT[@text='Autowired']
                      or DOT/IDENT[@text='Autowired']
                    ]"
            />
            <message
                key="matchxpath.match"
                value="@Autowired is forbidden. Use constructor injection with an unannotated constructor."
            />
        </module>

        <!-- Spring Data @Query hides database queries in repository annotations; keep persistence logic composable instead. -->
        <module name="MatchXpath">
            <property name="id" value="SpringDataQuery"/>
            <property
                name="query"
                value="//ANNOTATION[
                      IDENT[@text='Query']
                      or DOT/IDENT[@text='Query']
                    ]"
            />
            <message
                key="matchxpath.match"
                value="org.springframework.data.jpa.repository.Query is forbidden. Do not use @Query; use repository method derivation, Specifications, or another composable persistence API instead."
            />
        </module>

        <!-- Require Bean methods to remain package-private. -->
        <module name="MatchXpath">
            <property
                name="query"
                value="//METHOD_DEF[
                      MODIFIERS/ANNOTATION/IDENT[@text='Bean']
                      and MODIFIERS/*[not(self::ANNOTATION)]
                    ]"
            />
            <message
                key="matchxpath.match"
                value="@Bean methods must not declare any modifier keyword (package-private only)."
            />
        </module>
    </module>
</module>
